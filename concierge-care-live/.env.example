# Copy to .env (never commit it). Real environment variables win over this file.

# Adobe IMS access token for the user running the prototype. Optional here:
# you can also paste it at runtime via the "Connection" button (kept in memory only).
ADOBE_IMS_TOKEN=

# Coworker MCP endpoint. Default is the one registered for the Claude connector.
# Alternative gateway: https://cx-coworker-gateway.adobe.io/mcp
COWORKER_MCP_URL=https://mcp.coworker.experience.adobe.io/

# Optional: pin the org / sandbox (sent as x-gw-ims-org-id / x-sandbox-name)
ADOBE_ORG_ID=
ADOBE_SANDBOX=acs-onshore-demo

# Optional: name used in prompts. Leave blank to let Coworker resolve it.
CONCIERGE_NAME=Wknd - demo-DONOTDELETE

# Optional: where findings.json is written (default ./output)
# OUTPUT_DIR=

PORT=8787

# Logging / timing (optional)
# LOG_PAYLOADS=0          # log sizes only, not message text
# LOG_DIR=./logs
# COWORKER_TIMEOUT_MS=300000   # per-turn limit, 30000-900000
